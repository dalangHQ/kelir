# kelir development orchestrator
set shell := ["bash", "-uc"]

default:
    @just --list

# --- 1. SETUP & TOOLCHAINS ---
bootstrap:
    cargo install cargo-nextest sccache --locked
    rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl
    pnpm install --frozen-lockfile
    uv venv && uv pip install -e "packages/py[dev]"

# --- 2. LIGHTNING BUILD (<15s) ---
# Compiles host core using mold/lld linker and sccache
build-host:
    RUSTC_WRAPPER=sccache cargo build --workspace --exclude kelir-shim

# Compiles static 50KB in-guest musl init binary
build-shim target="aarch64-unknown-linux-musl":
    cargo zigbuild -p kelir-shim --release --target {{target}}
    @ls -lh target/{{target}}/release/kelir-shim

# Builds TS napi bindings
build-ts:
    pnpm --filter @kelir/core build

# --- 3. RAPID TEST ENGINE (<10s) ---
# Core kernel + plugin-testkit (the only things every plugin depends on)
test-core:
    cargo nextest run -p kelir-core -p kelir-plugin-testkit

# Every first-class plugin, independently. Failure in one does not mask others.
test-plugins:
    cargo nextest run -p plugin-pty -p plugin-vfs -p plugin-wire -p plugin-chaos -p plugin-ledger -p plugin-mcp -p plugin-oci-translator -p plugin-openshell-coordinator -p plugin-db-proxy -p plugin-mesh -p plugin-lock-broker -p plugin-supply-chain -p plugin-hyper-density -p plugin-cas-snapshot -p plugin-wire-ingress

# Single plugin (debugging)
test-plugin plugin:
    cargo nextest run -p plugin-{{plugin}}

# Plugin audit mirror — same command plugin-ci-reusable.yml runs
plugin-check plugin:
    cargo run -p kelir-plugin-cli -- check -p plugin-{{plugin}}

# Validate plugin dependency graph is strictly acyclic
plugin-check-graph:
    cargo run -p kelir-plugin-cli -- check --graph

# Spec gate — same two tiers CI runs; --json, exit-code asserted
cans-check:
    @cans check --refs-only --json | jq -e '.ok and .exitCode == 0'
    @cans check --json          | jq -e '.ok and .exitCode == 0'

# Decoupling proof — same exclusions as ci.yml plugin-isolation.
# Destroys the plugin dir; trap restores it on exit (success or fail).
test-isolation plugin:
    #!/usr/bin/env bash
    set -euo pipefail
    P="plugin-{{plugin}}"
    trap 'git checkout HEAD -- "crates/kelir-plugins/$P" Cargo.toml crates/kelir/Cargo.toml 2>/dev/null || true' EXIT
    rm -rf "crates/kelir-plugins/$P"
    sed -i "/crates\/kelir-plugins\/$P/d" Cargo.toml
    sed -i "/^$P\s*=/d" crates/kelir/Cargo.toml
    cargo nextest run --workspace \
        --exclude kelir \
        --exclude containerd-shim \
        --exclude openshell-grpc \
        --exclude mcp-server \
        --exclude kelir-integration

# Runs anti-TOCTOU, cgroup.freeze, and zombie reaper tests in isolated container/namespaces
test-shim:
    cargo nextest run -p kelir-shim

# Driver primitives; excludes test_hw_* paths that need real hardware
test-drivers:
    cargo nextest run -p driver-rustvmm -p driver-openvmm -p driver-bwrap -E 'not test(test_hw_)'

# Cross-plugin integration; requires real hypervisor (KVM/HVF)
test-integration:
    cargo nextest run -p kelir-integration

# Everything except integration (which requires real VM)
test-all: test-core test-plugins test-shim test-drivers

# Full TS context accumulation & type checking
typecheck:
    pnpm -r exec tsc --noEmit
    uv run mypy packages/py

# --- 3b. PARITY GATE ---
# Single implementation: kelir-plugin-cli runs vectors (Rust fixtures →
# TS + Python suites) and the surface manifest diff. CI calls the same
# subcommand.
parity: build-ts
    cargo run -p kelir-plugin-cli -- parity run

# --- 4. PRE-FLIGHT CHECK (Run before git push) ---
pre-flight: cans-check build-shim parity plugin-check-graph plugin-check-all test-isolation-all
    cargo fmt --all -- --check
    cargo clippy --workspace --exclude kelir-shim -- -D warnings
    pnpm -r exec eslint .
    just test-all
    just typecheck

# Aggregate targets — CI runs them as matrix cells; local runs the loop
plugin-check-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for p in pty vfs wire chaos ledger mcp oci-translator openshell-coordinator db-proxy mesh lock-broker supply-chain hyper-density cas-snapshot wire-ingress; do
        just plugin-check "$p"
    done

test-isolation-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for p in pty vfs wire chaos ledger mcp oci-translator openshell-coordinator db-proxy mesh lock-broker supply-chain hyper-density cas-snapshot wire-ingress; do
        just test-isolation "$p"
    done
